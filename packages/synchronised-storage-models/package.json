{
	"name": "@twin.org/synchronised-storage-models",
	"version": "0.0.3-next.2",
	"description": "Models which define the structure of the synchronised storage connectors and services",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/synchronised-storage.git",
		"directory": "packages/synchronised-storage-models"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage docs/reference",
		"build:schema": "ts-to-schema ./ts-to-schema.json ./src/schemas",
		"build:compile": "tspc",
		"build": "npm run build:schema && npm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run test:build && npm run docs"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/entity": "next",
		"@twin.org/identity-authentication": "next",
		"@twin.org/identity-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/standards-w3c-did": "next",
		"@twin.org/standards-w3c-odrl": "next"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/ts-to-schema": "next",
		"@vitest/coverage-v8": "4.0.8",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.11",
		"rimraf": "6.1.0",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.14",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.3",
		"vitest": "4.0.8"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"synchronised-storage",
		"models",
		"types",
		"schemas"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/synchronised-storage/issues"
	},
	"homepage": "https://twindev.org"
}
