{
	"name": "@twin.org/synchronised-storage-service",
	"version": "0.10.1-next.1",
	"description": "Service implementation that coordinates synchronisation state and exposes REST entry points.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-synchronised-storage.git",
		"directory": "packages/synchronised-storage-service"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "npm run docs:clean && npm run docs:generate && npm run docs:api",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/api-models": "next",
		"@twin.org/background-task-models": "next",
		"@twin.org/blob-storage-models": "next",
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/event-bus-models": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/synchronised-storage-models": "0.10.1-next.1",
		"@twin.org/trust-models": "next",
		"@twin.org/vault-models": "next",
		"@twin.org/verifiable-storage-models": "next",
		"@twin.org/web": "next"
	},
	"devDependencies": {
		"@twin.org/background-task-scheduler": "next",
		"@twin.org/blob-storage-connector-memory": "next",
		"@twin.org/blob-storage-service": "next",
		"@twin.org/crypto": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/event-bus-connector-local": "next",
		"@twin.org/event-bus-service": "next",
		"@twin.org/identity-connector-entity-storage": "next",
		"@twin.org/identity-models": "next",
		"@twin.org/logging-connector-entity-storage": "next",
		"@twin.org/logging-service": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/ts-to-openapi": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/verifiable-storage-connector-entity-storage": "next",
		"@twin.org/verifiable-storage-connector-iota": "next",
		"@types/node": "26.1.2",
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"synchronised-storage",
		"service",
		"microservice",
		"business-logic"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-synchronised-storage/issues"
	},
	"homepage": "https://twindev.org"
}
