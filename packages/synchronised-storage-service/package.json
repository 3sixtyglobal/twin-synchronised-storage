{
	"name": "@3sixty/synchronised-storage-service",
	"version": "0.20.0-next.0",
	"description": "Service implementation that coordinates synchronisation state and exposes REST entry points.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/synchronised-storage.git",
		"directory": "packages/synchronised-storage-service"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "pnpm run docs:clean && pnpm run docs:generate && pnpm run docs:api",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/api-models": "next",
		"@3sixty/background-task-models": "next",
		"@3sixty/blob-storage-models": "next",
		"@3sixty/context": "next",
		"@3sixty/core": "next",
		"@3sixty/entity": "next",
		"@3sixty/entity-storage-models": "next",
		"@3sixty/event-bus-models": "next",
		"@3sixty/logging-models": "next",
		"@3sixty/nameof": "next",
		"@3sixty/synchronised-storage-models": "0.20.0-next.0",
		"@3sixty/trust-models": "next",
		"@3sixty/vault-models": "next",
		"@3sixty/verifiable-storage-models": "next",
		"@3sixty/web": "next"
	},
	"devDependencies": {
		"@3sixty/background-task-scheduler": "next",
		"@3sixty/blob-storage-connector-memory": "next",
		"@3sixty/blob-storage-service": "next",
		"@3sixty/crypto": "next",
		"@3sixty/entity-storage-connector-memory": "next",
		"@3sixty/event-bus-connector-local": "next",
		"@3sixty/event-bus-service": "next",
		"@3sixty/identity-connector-entity-storage": "next",
		"@3sixty/identity-models": "next",
		"@3sixty/logging-connector-entity-storage": "next",
		"@3sixty/logging-service": "next",
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/ts-to-openapi": "next",
		"@3sixty/validate-locales": "next",
		"@3sixty/vault-connector-entity-storage": "next",
		"@3sixty/verifiable-storage-connector-entity-storage": "next",
		"@3sixty/verifiable-storage-connector-iota": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"synchronised-storage",
		"service",
		"microservice",
		"business-logic"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/synchronised-storage/issues"
	},
	"homepage": "https://3sixty.global"
}
